#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

// A 1-hour check of the cql-stress-sc-verify thread: longevity-sc-verify-100gb-4h shrunk to 6 nodes, 1 loader and 60 minutes of load.
// Strongly consistent tables are experimental and exist only in master builds.
longevityPipeline(
    backend: 'aws',
    region: 'eu-west-1',
    availability_zone: 'c',
    scylla_version: 'master:latest',
    test_name: 'longevity_test.LongevityTest.test_custom_time',
    test_config: '''["test-cases/features/strong-consistency/longevity-sc-verify-100gb-4h.yaml", "configurations/sc_verify/check-run-1h.yaml"]''',
    instance_provision_fallback_on_demand: true
)
